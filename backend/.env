# Backend environment configuration
# Override locally or via environment variables in production

ENV=development
DATABASE_URL=sqlite:///./protocol_authoring.db
CDISC_API_KEY=
CDISC_LIBRARY_BASE_URL=https://library.cdisc.org/api
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
SDR_BASE_URL=http://localhost:5000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]
HOST=0.0.0.0
PORT=8001

# Neo4j graph database (start with: docker compose up -d)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trialforge_dev
