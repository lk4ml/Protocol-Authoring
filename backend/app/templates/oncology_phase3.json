    "eligibilityCriteria": [
      {"id": "inc-1", "name": "I01", "text": "Male or female >= 18 years of age at the time of signing the informed consent", "category": "inclusion", "order": 0},
      {"id": "inc-2", "name": "I02", "text": "Histologically or cytologically confirmed diagnosis of the target tumor type", "category": "inclusion", "order": 1},
      {"id": "inc-3", "name": "I03", "text": "Measurable disease per RECIST 1.1", "category": "inclusion", "order": 2},
      {"id": "inc-4", "name": "I04", "text": "ECOG performance status of 0 or 1", "category": "inclusion", "order": 3},
      {"id": "inc-5", "name": "I05", "text": "Adequate organ function as defined in the protocol", "category": "inclusion", "order": 4},
      {"id": "exc-1", "name": "E01", "text": "Prior treatment with [specific therapy class] for the target indication", "category": "exclusion", "order": 0},
      {"id": "exc-2", "name": "E02", "text": "Known active brain metastases or leptomeningeal disease", "category": "exclusion", "order": 1},
      {"id": "exc-3", "name": "E03", "text": "History of another malignancy within 3 years (exceptions: adequately treated basal or squamous cell skin cancer, curatively treated in-situ cervical cancer)", "category": "exclusion", "order": 2},
