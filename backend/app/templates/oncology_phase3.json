    "objectives": [
      {
        "id": "obj-os",
        "name": "Overall Survival",
        "description": "To compare overall survival (OS) between treatment and control arms",
        "level": {"code": "C98772", "codeSystem": "http://www.cdisc.org", "decode": "Primary"},
        "endpoints": [
          {"id": "ep-os", "name": "Overall Survival (OS)", "description": "Time from randomization to death from any cause", "purpose": "Efficacy"}
        ]
      },
      {
        "id": "obj-pfs",
        "name": "Progression-Free Survival",
        "description": "To compare progression-free survival (PFS) per RECIST 1.1",
        "level": {"code": "C98773", "codeSystem": "http://www.cdisc.org", "decode": "Secondary"},
        "endpoints": [
          {"id": "ep-pfs", "name": "Progression-Free Survival (PFS)", "description": "Time from randomization to disease progression per RECIST 1.1 or death", "purpose": "Efficacy"}
        ]
      },
