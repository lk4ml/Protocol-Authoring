        "id": "obj-orr",
        "name": "Objective Response Rate",
        "description": "To evaluate objective response rate (ORR) per RECIST 1.1",
        "level": {"code": "C98773", "codeSystem": "http://www.cdisc.org", "decode": "Secondary"},
        "endpoints": [
          {"id": "ep-orr", "name": "Objective Response Rate (ORR)", "description": "Proportion of subjects with confirmed CR or PR per RECIST 1.1", "purpose": "Efficacy"}
        ]
